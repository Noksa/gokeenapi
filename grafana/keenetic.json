          "refId": "A",
          "expr": "sum(keenetic_hosts_active{router=~\"$router\"})",
          "legendFormat": "Active devices",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "range": false
        }
      ],
